# SaaS foundation (Phase 1)
# Copy to .env and fill in local values. Never commit real API keys.

ENVIRONMENT=development

DATABASE_URL=postgresql+psycopg://mpt:mpt@localhost:5432/moneyprinterturbo
# Local fallback without Postgres:
# DATABASE_URL=sqlite:///./saas.db

REDIS_URL=redis://localhost:6379/0
# Local fallback without Redis:
# REDIS_URL=memory://

JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRE_MINUTES=1440

CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:3001,http://127.0.0.1:3001

STORAGE_PROVIDER=local
STORAGE_PATH=./storage/saas
MAX_UPLOAD_BYTES=104857600

# Optional Phase 2 object storage (leave unset for local disk)
S3_BUCKET=
S3_REGION=us-east-1
S3_ENDPOINT_URL=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_PUBLIC_BASE_URL=
R2_ACCOUNT_ID=

OPENAI_API_KEY=
GEMINI_API_KEY=

NEXT_PUBLIC_API_URL=http://127.0.0.1:8000

# Phase 3 billing. local completes purchases without a card network.
# Live Stripe: BILLING_PROVIDER=stripe plus both secrets. Credits are added
# only from POST /api/v1/billing/webhooks/stripe after signature verification.
BILLING_PROVIDER=local
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

RATE_LIMIT_BACKEND=memory
JOB_STALE_SECONDS=180
JOB_MAX_RETRIES=3
SIGNED_URL_TTL=3600
# Production: AUTO_CREATE_SCHEMA=false and run Alembic
AUTO_CREATE_SCHEMA=true

# Phase 5 — AI Director / AI video (Replicate official-model API)
AI_VIDEO_ENABLED=true
AI_VIDEO_PROVIDER=replicate
AI_VIDEO_API_KEY=
AI_VIDEO_MODEL=luma/ray-flash-2-720p
AI_VIDEO_BASE_CREDITS=20
AI_VIDEO_MODEL_COSTS=
MAX_PARALLEL_SCENE_GENERATIONS=2
AI_VIDEO_POLL_INITIAL_SECONDS=10
AI_VIDEO_POLL_MAX_SECONDS=60
AI_VIDEO_MAX_WAIT_SECONDS=900
AI_VIDEO_FALLBACK_POLICY=ai_image,stock
AI_IMAGE_PROVIDER=replicate
AI_IMAGE_API_KEY=
AI_IMAGE_BASE_CREDITS=3
REPLICATE_WEBHOOK_SECRET=
